# 数据库连接地址
# 本地开发通常使用 SQLite，路径相对于 prisma/schema.prisma
DATABASE_URL="file:./dev.db"

# NextAuth 会话加密密钥
# 生产环境必须修改！可以使用 `openssl rand -base64 32` 生成
NEXTAUTH_SECRET=""

# First-time admin provisioning only (12–72 byte password); no default account.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Admin"

# 应用的基础 URL
# 本地开发通常是 http://localhost:3000
# Set production NEXTAUTH_URL to the exact Tailscale Serve HTTPS URL.
NEXTAUTH_URL="http://localhost:3000"

# 信任 Host 请求头
# 设置为 true 时，NextAuth 会根据请求头自动推断 URL，适合 Docker/PaaS 环境
AUTH_TRUST_HOST=true

# AI 服务提供商配置
# 可选值: "gemini" (默认) 或 "openai"
AI_PROVIDER="gemini"

# Comma-separated exact origins for custom AI gateways. Provider defaults are built in.
# Private/HTTP gateways require an explicit origin here (e.g. http://127.0.0.1:8081).
AI_ALLOWED_ORIGINS=""

# OpenAI 配置 (当 AI_PROVIDER="openai" 时需要)
OPENAI_API_KEY=""
OPENAI_BASE_URL="" # 可选，用于兼容的 API 服务
OPENAI_MODEL="gpt-4o" # 可选，默认为 gpt-4o

# Google Gemini 配置 (当 AI_PROVIDER="gemini"

# Comma-separated exact origins for custom AI gateways. Provider defaults are built in.
# Private/HTTP gateways require an explicit origin here (e.g. http://127.0.0.1:8081).
AI_ALLOWED_ORIGINS="" 时需要)
GOOGLE_API_KEY=""
GEMINI_BASE_URL="" # 可选，用于自定义 API 地址
GEMINI_MODEL="gemini-2.5-flash" # 可选，默认为 gemini-2.5-flash

# 日志配置
# 日志级别: trace, debug, info, warn, error, fatal
# 开发环境建议使用 debug，生产环境建议使用 info
LOG_LEVEL="debug"

# Database Debugging
# Set to "true" to enable SQL query logging
DEBUG_DB="false"

# Openclaw Agent API 配置
# 用于对接本地部署的 Openclaw agent 进行错题识别
OPENCLAW_API_URL=""  # Openclaw agent 服务地址
OPENCLAW_API_KEY=""  # Openclaw API 密钥
OPENCLAW_TIMEOUT=30000  # 请求超时时间（毫秒），默认30秒

# 本系统 API 认证模式配置
# 可选值: "credentials" (用户名密码登录，默认) 或 "apikey" (API Key认证)
OPENCLAW_AUTH_MODE="credentials"

# 本系统 API 密钥（用于 Openclaw agent 调用本系统）
# 仅当 OPENCLAW_AUTH_MODE=apikey 时需要配置
# 生成方式: openssl rand -hex 32
OPENCLAW_INTEGRATION_API_KEY=""
# Required for apikey mode: bind integration uploads to this single active account.
OPENCLAW_USER_EMAIL=""

# Optional: header set by a trusted reverse proxy that carries the client IP,
# e.g. CF-Connecting-IP (Cloudflare) or X-Forwarded-For (last hop is used).
# Enables per-IP login throttling. Leave unset when clients reach the app
# directly, since the header could then be forged.
AUTH_CLIENT_IP_HEADER=
