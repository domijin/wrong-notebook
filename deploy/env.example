# Required: real random secret, 32+ chars. Placeholders are rejected at startup.
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=

# Required: the exact HTTPS URL clients use. For Tailscale Serve this is
#   https://<machine>.<tailnet>.ts.net
NEXTAUTH_URL=

# First boot only: creates the first admin in an empty database. After the
# admin signs in, unset ADMIN_PASSWORD to avoid re-provisioning.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# App port on the host (defaults to 3000). Edit docker-compose.yml if you
# change this. The container itself always listens on 3000.
APP_PORT=3000

# Optional: extra AI gateway origins (comma-separated, no path)
#   e.g. https://gateway.example.com,http://127.0.0.1:8081
AI_ALLOWED_ORIGINS=

# Optional: Openclaw integration. If unset, the integration route is
# disabled. apikey mode also requires OPENCLAW_USER_EMAIL to bind the
# shared key to a single trusted account.
OPENCLAW_API_URL=
OPENCLAW_INTEGRATION_API_KEY=
OPENCLAW_USER_EMAIL=
OPENCLAW_API_KEY=

# info in production, debug in dev
LOG_LEVEL=info

# Optional: header set by a trusted reverse proxy that carries the client IP,
# e.g. CF-Connecting-IP (Cloudflare) or X-Forwarded-For (last hop is used).
# Enables per-IP login throttling. Leave unset when clients reach the app
# directly, since the header could then be forged.
AUTH_CLIENT_IP_HEADER=

# AI budget (see SECURITY.md). Admins are exempt but still count toward the site total;
# 0 turns a limit off.
AI_DAILY_LIMIT_PER_USER=200
AI_DAILY_LIMIT_SITE=1500
# With the official MiniMax API on a Token Plan key, pause AI for non-admins when the
# plan's weekly or 5-hour remaining quota drops below these percentages.
AI_QUOTA_MIN_WEEKLY_PERCENT=25
AI_QUOTA_MIN_INTERVAL_PERCENT=10
# Time zone whose midnight starts a new day for the daily limits.
AI_QUOTA_TIMEZONE=Asia/Shanghai
